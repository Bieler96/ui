{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"declaration": true,
		"declarationDir": "dist",
		"emitDeclarationOnly": false,
		"outDir": "dist",
		"strict": true,
		"jsx": "react-jsx",
		"esModuleInterop": true,
		"moduleResolution": "Node",
		"skipLibCheck": true
	},
	"include": [
		"src"
	],
	"exclude": [
		"dist",
		"node_modules"
	]
}